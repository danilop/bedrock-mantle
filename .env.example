# Amazon Bedrock Mantle Configuration
# Copy this file to .env and fill in your values

# Mantle endpoint URL
# Format: https://bedrock-mantle.<region>.api.aws/v1
# The CLI automatically selects the correct path per model:
#   GPT-5.5 / GPT-5.4    -> /openai/v1
#   GPT-OSS-120b / OSS-20b -> /v1
#
# GPT-5.5 available in: us-east-2
# GPT-5.4 available in: us-east-2, us-west-2
OPENAI_BASE_URL=https://bedrock-mantle.us-east-2.api.aws/v1

# Amazon Bedrock API Key
# Generate one at: https://docs.aws.amazon.com/bedrock/latest/userguide/api-keys.html
OPENAI_API_KEY=your-amazon-bedrock-api-key
